{{!-- ======================================================================
      HALAMAN 2 — DATA BUKU
      Menampilkan seluruh koleksi buku, pencarian, dan aksi CRUD.
     ====================================================================== --}}

<div class="card">
  <div class="card-header">
    <span>
      <i class="bi bi-journal-bookmark me-2"></i>Koleksi Buku
      <span class="badge text-bg-secondary ms-2">{{total}} judul</span>
    </span>

    <div class="d-flex gap-2">
      <form class="d-flex gap-2" method="GET" action="/books">
        <input type="text" name="search" value="{{search}}" class="form-control form-control-sm"
               style="min-width:230px" placeholder="Cari judul, pengarang, atau kode...">
        <button class="btn btn-sm btn-outline-secondary" type="submit">
          <i class="bi bi-search"></i>
        </button>
        {{#if search}}
          <a href="/books" class="btn btn-sm btn-outline-secondary" title="Bersihkan pencarian">
            <i class="bi bi-x-lg"></i>
          </a>
        {{/if}}
      </form>

      <a href="/books/new" class="btn btn-sm btn-primary text-nowrap">
        <i class="bi bi-plus-lg"></i> Tambah Buku
      </a>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th style="width:44px">No</th>
          <th>Kode</th>
          <th>Judul</th>
          <th>Pengarang</th>
          <th>Penerbit</th>
          <th class="text-center">Tahun</th>
          <th>Kategori</th>
          <th class="text-center">Stok</th>
          <th class="text-center">Tersedia</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {{#each books}}
          <tr>
            <td class="text-muted">{{inc @index}}</td>
            <td><code>{{this.code}}</code></td>
            <td class="fw-semibold">{{this.title}}</td>
            <td>{{this.author}}</td>
            <td class="text-muted">{{this.publisher}}</td>
            <td class="text-center">{{this.publishedYear}}</td>
            <td>
              <span class="badge text-bg-{{categoryColor this.category}}">{{this.category}}</span>
            </td>
            <td class="text-center">{{this.stock}}</td>
            <td class="text-center">
              <span class="badge text-bg-{{stockColor this.available}}">{{this.available}}</span>
            </td>
            <td class="text-end text-nowrap">
              <a href="/books/{{this.id}}/edit" class="btn btn-sm btn-outline-primary" title="Ubah">
                <i class="bi bi-pencil"></i>
              </a>
              <form method="POST" action="/books/{{this.id}}/delete" class="d-inline"
                    onsubmit="return confirm('Hapus buku &quot;{{this.title}}&quot;? Tindakan ini tidak dapat dibatalkan.');">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="10">
              <div class="kosong">
                <i class="bi bi-search"></i>
                {{#if search}}
                  Tidak ada buku yang cocok dengan kata kunci "<b>{{search}}</b>".
                {{else}}
                  Belum ada data buku. Silakan tambahkan terlebih dahulu.
                {{/if}}
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
