{{!-- ======================================================================
      HALAMAN 1 — DASHBOARD
      Menampilkan ringkasan koleksi, statistik transaksi, dua buah grafik
      (Chart.js), dan daftar transaksi terbaru.
     ====================================================================== --}}

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon bg-primary bg-opacity-10 text-primary">
        <i class="bi bi-journal-bookmark-fill"></i>
      </div>
      <div>
        <div class="stat-value">{{bookSummary.totalTitles}}</div>
        <div class="stat-label">Judul Buku</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon bg-success bg-opacity-10 text-success">
        <i class="bi bi-check2-square"></i>
      </div>
      <div>
        <div class="stat-value">{{bookSummary.totalAvailable}}</div>
        <div class="stat-label">Eksemplar Tersedia</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon bg-warning bg-opacity-10 text-warning">
        <i class="bi bi-arrow-left-right"></i>
      </div>
      <div>
        <div class="stat-value">{{loanSummary.ongoing}}</div>
        <div class="stat-label">Sedang Dipinjam</div>
      </div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="stat-card">
      <div class="stat-icon bg-danger bg-opacity-10 text-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
      </div>
      <div>
        <div class="stat-value">{{loanSummary.overdue}}</div>
        <div class="stat-label">Terlambat</div>
      </div>
    </div>
  </div>
</div>

{{#if (gt loanSummary.overdue 0)}}
  <div class="alert alert-warning d-flex align-items-center justify-content-between">
    <div>
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      Terdapat <b>{{loanSummary.overdue}} peminjaman</b> yang melewati jatuh tempo.
    </div>
    <a href="/reports" class="btn btn-sm btn-warning">
      <i class="bi bi-envelope"></i> Kirim Pengingat
    </a>
  </div>
{{/if}}

<div class="row g-3 mb-3">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header">
        <span><i class="bi bi-bar-chart-line me-2"></i>Peminjaman per Bulan &mdash; {{currentYear}}</span>
      </div>
      <div class="card-body">
        <div class="chart-box">
          <canvas id="monthlyChart" data-values="{{monthlyData}}"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header">
        <span><i class="bi bi-pie-chart me-2"></i>Koleksi per Kategori</span>
      </div>
      <div class="card-body">
        <div class="chart-box">
          <canvas
            id="categoryChart"
            data-labels="{{categoryLabels}}"
            data-values="{{categoryData}}"
          ></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span><i class="bi bi-clock-history me-2"></i>Transaksi Terbaru</span>
    <a href="/loans" class="btn btn-sm btn-outline-primary">Lihat Semua</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Kode</th>
          <th>Peminjam</th>
          <th>Judul Buku</th>
          <th>Tgl Pinjam</th>
          <th>Jatuh Tempo</th>
          <th>Status</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {{#each recentLoans}}
          <tr>
            <td><code>{{this.code}}</code></td>
            <td>{{this.borrowerName}}</td>
            <td>{{this.book.title}}</td>
            <td>{{formatDate this.borrowedAt}}</td>
            <td>{{formatDate this.dueAt}}</td>
            <td>
              {{!-- displayStatus sudah dihitung di controller lewat toView(),
                    sehingga di sini berupa properti biasa — bukan pemanggilan
                    method, yang perlakuannya tidak dapat diandalkan. --}}
              <span class="badge text-bg-{{statusColor this.displayStatus}}">
                {{this.displayStatus}}
              </span>
            </td>
            <td class="text-end">
              <a href="/loans/{{this.id}}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="7">
              <div class="kosong">
                <i class="bi bi-inbox"></i>
                Belum ada transaksi peminjaman.
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

{{!-- Skrip grafik dipisahkan ke berkas .js tersendiri agar tetap berupa
      JavaScript murni dan aman diformat ulang oleh perkakas seperti Prettier. --}}
<script src="/aset/js/dashboard.js"></script>
