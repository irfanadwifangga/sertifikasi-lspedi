---
/**
 * HALAMAN DETAIL BERITA — dibuat dinamis dari data.
 *
 * Astro membangun satu halaman statis untuk setiap berita berdasarkan daftar
 * yang dikembalikan `getStaticPaths()`. Menambah satu entri di berita.json
 * otomatis menghasilkan satu halaman baru, tanpa membuat berkas baru.
 */
import Layout from '../../layouts/Layout.astro';
import KartuBerita from '../../components/KartuBerita.astro';

import semuaBerita from '../../data/berita.json';
import { formatDate, sortByNewest } from '../../utils/format';

/** Menentukan alamat halaman yang perlu dibangun untuk tiap berita. */
export function getStaticPaths() {
  return semuaBerita.map((berita) => ({
    params: { slug: berita.slug },
    props: { berita },
  }));
}

const { berita } = Astro.props;

/** Tiga berita lain sebagai bacaan lanjutan. */
const beritaLain = sortByNewest(semuaBerita)
  .filter((b) => b.slug !== berita.slug)
  .slice(0, 3);
---

<Layout judul={berita.judul} deskripsi={berita.ringkasan}>
  <article>
    <!-- Kepala berita -->
    <header class="relative overflow-hidden bg-navy-900 pb-14 pt-28 sm:pb-20 sm:pt-36">
      <img
        src={berita.gambar}
        alt=""
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full! w-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/85 to-navy-900/70"></div>

      <div class="wrap relative">
        <nav aria-label="Remah roti" class="flex items-center gap-2 text-[13px] text-navy-200">
          <a href="/" class="transition-colors hover:text-amber-brand">Beranda</a>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="m9 6 6 6-6 6" />
          </svg>
          <a href="/berita" class="transition-colors hover:text-amber-brand">Berita</a>
        </nav>

        <span class="mt-5 inline-block rounded-full bg-amber-brand px-3 py-1 text-[12px] font-bold text-navy-900">
          {berita.kategori}
        </span>

        <h1 class="mt-4 max-w-3xl font-display text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-[42px]">
          {berita.judul}
        </h1>

        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13.5px] text-navy-200">
          <span class="flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" />
            </svg>
            <time datetime={berita.tanggal}>{formatDate(berita.tanggal)}</time>
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="3.4" /><path d="M4 20a8 8 0 0 1 16 0" />
            </svg>
            {berita.penulis}
          </span>
        </div>
      </div>
    </header>

    <!-- Isi berita -->
    <div class="py-14 sm:py-20">
      <div class="wrap">
        <div class="mx-auto max-w-3xl">
          <img
            src={berita.gambar}
            alt={berita.judul}
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl shadow-md"
          />

          <p class="mt-9 border-l-4 border-amber-brand pl-5 text-[17px] font-medium leading-relaxed text-navy-800">
            {berita.ringkasan}
          </p>

          <div class="mt-7 space-y-5">
            {
              berita.isi.map((paragraf) => (
                <p class="text-[16px] leading-[1.85] text-slate-700">{paragraf}</p>
              ))
            }
          </div>

          <div class="mt-10 flex items-center justify-between border-t border-slate-200 pt-6">
            <a
              href="/berita"
              class="inline-flex items-center gap-2 text-sm font-semibold text-navy-600 transition-colors hover:text-amber-deep"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M11 18l-6-6 6-6" />
              </svg>
              Kembali ke daftar berita
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Berita lainnya -->
  <section class="bg-navy-50 py-16 sm:py-20">
    <div class="wrap">
      <h2 class="rule font-display text-2xl font-extrabold text-navy-900 sm:text-3xl">Berita Lainnya</h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {beritaLain.map((b, i) => <KartuBerita berita={b} urutan={i} />)}
      </div>
    </div>
  </section>
</Layout>
