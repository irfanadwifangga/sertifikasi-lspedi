---
/**
 * HALAMAN TIDAK DITEMUKAN
 *
 * Astro otomatis menampilkan berkas ini ketika pengunjung membuka alamat
 * yang tidak tersedia. Menyediakan halaman ini termasuk penerapan
 * "best practices": pengunjung tetap mendapat jalan kembali, bukan halaman
 * kosong bawaan peladen.
 */
import Layout from '../layouts/Layout.astro';

const links = [
  { label: 'Beranda', href: '/' },
  { label: 'Profil Sekolah', href: '/profil' },
  { label: 'Program Keahlian', href: '/program-keahlian' },
  { label: 'Berita', href: '/berita' },
];
---

<Layout title="Halaman Tidak Ditemukan">
  <section class="relative flex min-h-[78vh] items-center overflow-hidden bg-navy-900 pt-20">
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-amber-brand/10"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5"></div>

    <div class="wrap relative text-center">
      <p class="font-display text-[110px] font-extrabold leading-none text-amber-brand sm:text-[150px]">404</p>

      <h1 class="mt-2 font-display text-3xl font-extrabold text-white sm:text-4xl">
        Halaman Tidak Ditemukan
      </h1>

      <p class="mx-auto mt-5 max-w-lg text-[15.5px] leading-relaxed text-navy-200">
        Alamat yang Anda tuju tidak tersedia. Halaman mungkin telah dipindahkan,
        atau alamatnya keliru saat diketik.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-2.5">
        {
          links.map((t) => (
            <a
              href={t.href}
              class="rounded-lg border border-white/25 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/12"
            >
              {t.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
