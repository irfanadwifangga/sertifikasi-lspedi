---
/**
 * HALAMAN 3 — EKSTRAKURIKULER
 *
 * Menampilkan seluruh kegiatan ekstrakurikuler lengkap dengan penyaring
 * kategori yang bekerja tanpa memuat ulang halaman.
 */
import Layout from '../layouts/Layout.astro';
import HeaderHalaman from '../components/HeaderHalaman.astro';

import ekskul from '../data/ekstrakurikuler.json';

/**
 * Daftar kategori dibentuk otomatis dari data, bukan diketik manual.
 * Menambah ekstrakurikuler berkategori baru langsung memunculkan tombol
 * penyaringnya tanpa menyentuh kode ini.
 */
const kategori = ['Semua', ...new Set(ekskul.map((e) => e.kategori))];

const ikon: Record<string, string> = {
  tent: 'M12 3 3 20h7l2-4 2 4h7zm0 5 4 9h-8z',
  wrench: 'M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 1 5.4-5.4l-2.5 2.5 2.1 2.1z',
  heart: 'M12 20s-7-4.6-7-9.3A3.7 3.7 0 0 1 12 8a3.7 3.7 0 0 1 7 2.7C19 15.4 12 20 12 20z',
  ball: 'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 3 3.5 2.5-1.3 4h-4.4l-1.3-4z',
  moon: 'M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z',
  music: 'M12 3v10.6A4 4 0 1 0 14 17V7h4V3z',
};

const warna: Record<string, string> = {
  amber: 'bg-amber-100 text-amber-700',
  blue: 'bg-sky-100 text-sky-700',
  rose: 'bg-rose-100 text-rose-700',
  emerald: 'bg-emerald-100 text-emerald-700',
  teal: 'bg-teal-100 text-teal-700',
  violet: 'bg-violet-100 text-violet-700',
};
---

<Layout
  judul="Ekstrakurikuler"
  deskripsi="Daftar kegiatan ekstrakurikuler sebagai wadah pengembangan minat, bakat, dan karakter peserta didik."
>
  <HeaderHalaman
    remah="Ekstrakurikuler"
    judul="Ekstrakurikuler"
    keterangan="Kegiatan di luar jam pelajaran sebagai wadah pengembangan minat, bakat, kepemimpinan, dan karakter peserta didik."
  />

  <section class="py-16 sm:py-24">
    <div class="wrap">
      <!-- Penyaring kategori -->
      <div class="flex flex-wrap justify-center gap-2.5" data-aos="fade-up">
        {
          kategori.map((k, i) => (
            <button
              type="button"
              class="filter-ekskul rounded-full border px-4.5 py-2 text-[13.5px] font-semibold transition-colors"
              data-kategori={k}
              data-aktif={i === 0}
            >
              {k}
            </button>
          ))
        }
      </div>

      <!-- Kartu ekstrakurikuler -->
      <div id="daftar-ekskul" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          ekskul.map((e, i) => (
            <article
              class="kartu-ekskul card card-hover flex flex-col p-7"
              data-kategori={e.kategori}
              data-aos="fade-up"
              data-aos-delay={(i % 3) * 90}
            >
              <div class={`inline-flex h-13 w-13 items-center justify-center rounded-xl ${warna[e.warna]}`}>
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                  <path d={ikon[e.ikon]} />
                </svg>
              </div>

              <div class="mt-5 flex items-center gap-2">
                <h2 class="font-display text-lg font-bold text-navy-900">{e.nama}</h2>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-600">
                  {e.kategori}
                </span>
              </div>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{e.deskripsi}</p>

              <dl class="mt-5 space-y-2 border-t border-slate-100 pt-4 text-[13px]">
                <div class="flex gap-2">
                  <dt class="flex items-center gap-1.5 text-slate-500">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                    </svg>
                    Jadwal
                  </dt>
                  <dd class="font-semibold text-navy-800">{e.jadwal}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="flex items-center gap-1.5 text-slate-500">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="8" r="3.4" /><path d="M4 20a8 8 0 0 1 16 0" />
                    </svg>
                    Pembina
                  </dt>
                  <dd class="font-semibold text-navy-800">{e.pembina}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>

      <!-- Pesan bila tidak ada hasil -->
      <p id="ekskul-kosong" class="hidden py-16 text-center text-slate-500">
        Belum ada kegiatan pada kategori ini.
      </p>
    </div>
  </section>
</Layout>

<style>
  .filter-ekskul {
    border-color: #dbe2ec;
    background: #ffffff;
    color: #33415c;
  }

  .filter-ekskul:hover {
    border-color: var(--color-navy-400);
    color: var(--color-navy-700);
  }

  .filter-ekskul[data-aktif='true'] {
    border-color: var(--color-navy-800);
    background: var(--color-navy-800);
    color: #ffffff;
  }
</style>

<script>
  /**
   * Penyaring kategori ekstrakurikuler.
   *
   * Bekerja sepenuhnya di sisi peramban: kartu yang tidak sesuai kategori
   * disembunyikan, tanpa memuat ulang halaman. Bila tidak ada kartu tersisa,
   * ditampilkan pesan pengganti.
   */
  function siapkanFilterEkskul(): void {
    const tombolSemua = document.querySelectorAll<HTMLButtonElement>('.filter-ekskul');
    const kartuSemua = document.querySelectorAll<HTMLElement>('.kartu-ekskul');
    const pesanKosong = document.getElementById('ekskul-kosong');

    if (tombolSemua.length === 0 || !pesanKosong) return;

    /**
     * Menampilkan kartu sesuai kategori terpilih.
     *
     * @param pilihan Nama kategori, atau "Semua" untuk menampilkan seluruhnya.
     */
    function saring(pilihan: string): void {
      let terlihat = 0;

      kartuSemua.forEach((kartu) => {
        const cocok = pilihan === 'Semua' || kartu.dataset.kategori === pilihan;
        kartu.classList.toggle('hidden', !cocok);
        if (cocok) terlihat += 1;
      });

      pesanKosong!.classList.toggle('hidden', terlihat > 0);
    }

    tombolSemua.forEach((tombol) => {
      tombol.addEventListener('click', () => {
        // Tandai tombol yang sedang aktif.
        tombolSemua.forEach((t) => t.setAttribute('data-aktif', 'false'));
        tombol.setAttribute('data-aktif', 'true');

        saring(tombol.dataset.kategori ?? 'Semua');
      });
    });
  }

  siapkanFilterEkskul();
  document.addEventListener('astro:page-load', siapkanFilterEkskul);
</script>
