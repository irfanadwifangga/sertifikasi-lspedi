---
/**
 * HALAMAN 5 — BERITA
 *
 * Menampilkan seluruh berita kegiatan sekolah, diurutkan dari yang terbaru,
 * dengan kotak pencarian yang menyaring secara langsung saat diketik.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsCard from '../components/NewsCard.astro';

import semuaBerita from '../data/berita.json';
import { sortByNewest } from '../utils/format';

const news = sortByNewest(semuaBerita);
---

<Layout
  title="Berita"
  description="Kabar terbaru mengenai kegiatan akademik, prestasi, dan pengabdian masyarakat sekolah."
>
  <PageHeader
    breadcrumb="Berita"
    title="Berita Kegiatan"
    subtitle="Kumpulan kabar mengenai kegiatan akademik, prestasi peserta didik, dan pengabdian masyarakat yang berlangsung di sekolah."
  />

  <section class="py-16 sm:py-24">
    <div class="wrap">
      <!-- Pencarian -->
      <div class="mx-auto max-w-xl" data-aos="fade-up">
        <label for="cari-berita" class="sr-only">Cari news</label>
        <div class="relative">
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
          >
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" />
          </svg>
          <input
            id="cari-berita"
            type="search"
            placeholder="Cari judul atau kategori berita..."
            autocomplete="off"
            class="w-full rounded-xl border border-slate-300 bg-white py-3.5 pl-12 pr-4 text-[15px] outline-none transition-colors focus:border-navy-600 focus:ring-4 focus:ring-navy-600/12"
          />
        </div>
        <p id="hasil-cari" class="mt-3 text-center text-[13px] text-slate-500">
          Menampilkan {news.length} news.
        </p>
      </div>

      <!-- Daftar news -->
      <div id="daftar-berita" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          news.map((b, i) => (
            <div
              class="item-berita"
              data-title={b.judul.toLowerCase()}
              data-category={b.kategori.toLowerCase()}
            >
              <NewsCard news={b} index={i % 3} />
            </div>
          ))
        }
      </div>

      <p id="berita-kosong" class="hidden py-16 text-center text-slate-500">
        Tidak ada news yang matches dengan kata keyword tersebut.
      </p>
    </div>
  </section>
</Layout>

<script>
  /**
   * Pencarian berita secara langsung.
   *
   * Penyaringan dilakukan di sisi peramban terhadap judul dan kategori.
   * Pemanggilan ditunda sepersekian detik (debounce) agar penyaringan tidak
   * dijalankan pada setiap ketukan tombol.
   */
  function setupNewsSearch(): void {
    const input = document.getElementById('cari-berita') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLElement>('.item-berita');
    const info = document.getElementById('hasil-cari');
    const emptyMessage = document.getElementById('berita-kosong');

    if (!input || !info || !emptyMessage) return;

    let debounceTimer: number | undefined;

    /**
     * Menyaring kartu berita berdasarkan kata kunci.
     *
     * @param keyword Kata kunci yang diketik pengguna.
     */
    function applyFilter(keyword: string): void {
      const query = keyword.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const title = item.dataset.title ?? '';
        const category = item.dataset.category ?? '';
        const matches = query === '' || title.includes(query) || category.includes(query);

        item.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });

      info!.textContent =
        query === ''
          ? `Menampilkan ${items.length} berita.`
          : `Ditemukan ${visible} berita untuk "${keyword.trim()}".`;

      emptyMessage!.classList.toggle('hidden', visible > 0);
    }

    input.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => applyFilter(input.value), 180);
    });
  }

  setupNewsSearch();
  document.addEventListener('astro:page-load', setupNewsSearch);
</script>
