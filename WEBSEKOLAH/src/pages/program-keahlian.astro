---
/**
 * HALAMAN 6 — PROGRAM KEAHLIAN
 *
 * Menjabarkan tiga program keahlian beserta kompetensi dan prospek kerjanya.
 * Daftar kompetensi disimpan di halaman ini karena sifatnya statis dan hanya
 * dipakai di sini.
 */
import Layout from '../layouts/Layout.astro';
import HeaderHalaman from '../components/HeaderHalaman.astro';
import Judul from '../components/Judul.astro';

import sekolah from '../data/sekolah.json';

const { programKeahlian, statistik } = sekolah;

/** Rincian kompetensi dan prospek kerja, dikaitkan lewat singkatan program. */
const rincian: Record<string, { kompetensi: string[]; prospek: string[] }> = {
  TKRO: {
    kompetensi: [
      'Perawatan berkala mesin kendaraan ringan',
      'Perbaikan sistem kelistrikan dan pengapian',
      'Perawatan sistem pemindah tenaga',
      'Perbaikan sistem rem, kemudi, dan suspensi',
      'Penggunaan alat diagnosis berbasis komputer',
    ],
    prospek: ['Teknisi bengkel resmi', 'Mekanik perusahaan otobus', 'Wirausaha bengkel mandiri', 'Melanjutkan ke perguruan tinggi'],
  },
  TBSM: {
    kompetensi: [
      'Servis berkala sepeda motor',
      'Diagnosis kerusakan mesin dan kelistrikan',
      'Perbaikan sistem injeksi bahan bakar',
      'Pengelolaan administrasi bengkel',
      'Pelayanan pelanggan dan penjualan suku cadang',
    ],
    prospek: ['Teknisi bengkel resmi sepeda motor', 'Service advisor', 'Wirausaha bengkel dan toko suku cadang', 'Melanjutkan ke perguruan tinggi'],
  },
  TEI: {
    kompetensi: [
      'Perakitan rangkaian elektronika dasar',
      'Pemrograman mikrokontroler',
      'Perawatan sistem kendali industri',
      'Pembacaan gambar teknik elektronika',
      'Pengujian dan kalibrasi peralatan',
    ],
    prospek: ['Teknisi elektronika industri', 'Operator sistem kendali', 'Teknisi perawatan mesin produksi', 'Melanjutkan ke perguruan tinggi'],
  },
};

const ikon: Record<string, string> = {
  wrench: 'M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 1 5.4-5.4l-2.5 2.5 2.1 2.1z',
  bike: 'M6 14a4 4 0 1 0 4 4 4 4 0 0 0-4-4zm12 0a4 4 0 1 0 4 4 4 4 0 0 0-4-4zM9 8h6l3 6M9 8 6 14',
  chip: 'M8 8h8v8H8zM4 9h2v2H4zm0 4h2v2H4zm14-4h2v2h-2zm0 4h2v2h-2zM9 4h2v2H9zm4 0h2v2h-2zM9 18h2v2H9zm4 0h2v2h-2z',
};

const gradasi: Record<string, string> = {
  blue: 'from-sky-500 to-blue-700',
  orange: 'from-amber-500 to-orange-700',
  violet: 'from-violet-500 to-purple-700',
};
---

<Layout
  judul="Program Keahlian"
  deskripsi="Tiga program keahlian bidang teknologi yang dirancang mengikuti kebutuhan dunia usaha dan dunia industri."
>
  <HeaderHalaman
    remah="Program Keahlian"
    judul="Program Keahlian"
    keterangan={`Tiga program keahlian dengan total ${statistik.rombonganBelajar} rombongan belajar, seluruhnya dirancang mengikuti kebutuhan dunia usaha dan dunia industri.`}
  />

  <section class="py-16 sm:py-24">
    <div class="wrap space-y-16">
      {
        programKeahlian.map((p, i) => {
          const detail = rincian[p.singkatan];
          const terbalik = i % 2 === 1;

          return (
            <article
              class={`grid gap-10 lg:grid-cols-2 lg:items-center ${terbalik ? 'lg:[&>*:first-child]:order-2' : ''}`}
              data-aos="fade-up"
            >
              {/* Kartu identitas program */}
              <div class={`rounded-2xl bg-gradient-to-br ${gradasi[p.warna]} p-8 text-white sm:p-10`}>
                <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-sm">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                    <path d={ikon[p.ikon]} />
                  </svg>
                </div>

                <p class="mt-6 text-sm font-bold uppercase tracking-[0.16em] text-white/80">
                  {p.singkatan}
                </p>
                <h2 class="mt-1 font-display text-2xl font-extrabold leading-tight sm:text-3xl">
                  {p.nama}
                </h2>
                <p class="mt-4 text-[15px] leading-relaxed text-white/90">{p.deskripsi}</p>

                <div class="mt-7 inline-flex items-center gap-2 rounded-lg bg-white/15 px-4 py-2.5 text-sm font-semibold backdrop-blur-sm">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="5" width="18" height="11" rx="2" /><path d="M7 20h10" />
                  </svg>
                  {p.rombel} rombongan belajar
                </div>
              </div>

              {/* Kompetensi dan prospek */}
              <div>
                <h3 class="font-display text-lg font-bold text-navy-900">Kompetensi yang Dipelajari</h3>
                <ul class="mt-4 space-y-2.5">
                  {detail.kompetensi.map((k) => (
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m5 13 4 4L19 7" />
                        </svg>
                      </span>
                      <span class="text-[15px] text-slate-700">{k}</span>
                    </li>
                  ))}
                </ul>

                <h3 class="mt-8 font-display text-lg font-bold text-navy-900">Prospek Lulusan</h3>
                <div class="mt-4 flex flex-wrap gap-2">
                  {detail.prospek.map((pr) => (
                    <span class="rounded-lg bg-navy-100 px-3 py-1.5 text-[13px] font-semibold text-navy-700">
                      {pr}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="bg-navy-50 py-16">
    <div class="wrap text-center">
      <Judul
        tengah
        judul="Tertarik bergabung?"
        keterangan="Hubungi panitia penerimaan peserta didik baru untuk informasi jadwal dan persyaratan."
      />
      <div class="mt-8">
        <a href="/kontak" class="btn bg-navy-800 text-white hover:bg-navy-600">Hubungi Kami</a>
      </div>
    </div>
  </section>
</Layout>
