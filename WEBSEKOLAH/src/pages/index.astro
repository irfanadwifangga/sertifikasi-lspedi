---
/**
 * HALAMAN 1 — BERANDA
 *
 * Memuat seluruh unsur yang diminta soal untuk halaman utama:
 *  - Menu utama interaktif (melalui komponen Navbar pada Layout)
 *  - Berita kegiatan sekolah
 *  - Galeri
 *  - Informasi jumlah guru dan siswa
 */
import Layout from '../layouts/Layout.astro';
import Judul from '../components/Judul.astro';
import KartuBerita from '../components/KartuBerita.astro';
import Statistik from '../components/Statistik.astro';
import VideoProfil from '../components/VideoProfil.astro';

import sekolah from '../data/sekolah.json';
import semuaBerita from '../data/berita.json';
import galeri from '../data/galeri.json';

import { sortByNewest } from '../utils/format';

const { identitas, sambutan, programKeahlian, statistik } = sekolah;

/** Tiga berita terbaru untuk halaman utama. */
const beritaTerbaru = sortByNewest(semuaBerita).slice(0, 3);

/** Enam foto pertama sebagai cuplikan galeri. */
const cuplikanGaleri = galeri.slice(0, 6);

const totalSiswa = statistik.siswaLakiLaki + statistik.siswaPerempuan;

/** Gambar sampul yang bergantian pada bagian hero. */
const slideHero = [
  { gambar: '/img/hero.svg', judul: 'Terampil, Berkarakter, Siap Kerja', teks: `Sekolah menengah kejuruan bidang teknologi di ${sekolah.kontak.kabupaten}, berdiri sejak ${identitas.tahunBerdiri}.` },
  { gambar: '/img/galeri-bengkel.svg', judul: 'Belajar Langsung di Bengkel', teks: 'Praktik dilakukan pada bengkel sekolah dengan peralatan sesuai standar industri.' },
  { gambar: '/img/galeri-lks.svg', judul: 'Berprestasi hingga Tingkat Provinsi', teks: 'Peserta didik kami rutin mengikuti dan memenangi Lomba Kompetensi Siswa.' },
];

const ikonProgram: Record<string, string> = {
  wrench: 'M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 1 5.4-5.4l-2.5 2.5 2.1 2.1z',
  bike: 'M6 14a4 4 0 1 0 4 4 4 4 0 0 0-4-4zm12 0a4 4 0 1 0 4 4 4 4 0 0 0-4-4zM9 8h6l3 6M9 8 6 14',
  chip: 'M8 8h8v8H8zM4 9h2v2H4zm0 4h2v2H4zm14-4h2v2h-2zm0 4h2v2h-2zM9 4h2v2H9zm4 0h2v2h-2zM9 18h2v2H9zm4 0h2v2h-2z',
};

const warnaProgram: Record<string, string> = {
  blue: 'from-sky-500 to-blue-700',
  orange: 'from-amber-500 to-orange-700',
  violet: 'from-violet-500 to-purple-700',
};
---

<Layout judul="Beranda" deskripsi={`${identitas.nama} — ${identitas.tagline}`}>
  <!-- ================= HERO ================= -->
  <section class="relative">
    <div class="swiper hero-swiper h-140 sm:h-155 lg:h-170">
      <div class="swiper-wrapper">
        {
          slideHero.map((s, iSlide) => (
            <div class="swiper-slide relative">
              <img
                src={s.gambar}
                alt=""
                width="1600"
                height="900"
                loading={iSlide === 0 ? 'eager' : 'lazy'}
                fetchpriority={iSlide === 0 ? 'high' : 'auto'}
                decoding="async"
                class="absolute inset-0 h-full! w-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-navy-900/92 via-navy-900/70 to-navy-900/30" />

              <div class="wrap relative flex h-full items-center">
                <div class="max-w-2xl pt-16">
                  <span class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-[12px] font-semibold text-white backdrop-blur-sm">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber-brand" />
                    Akreditasi {identitas.akreditasi} &middot; NPSN {identitas.npsn}
                  </span>

                  <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.1] text-white sm:text-5xl lg:text-6xl">
                    {s.judul}
                  </h1>

                  <p class="mt-5 max-w-xl text-[16px] leading-relaxed text-navy-100 sm:text-[17px]">
                    {s.teks}
                  </p>

                  <div class="mt-8 flex flex-wrap gap-3">
                    <a href="/program-keahlian" class="btn btn-primary">
                      Lihat Program Keahlian
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </a>
                    <a href="/profil" class="btn btn-outline">Profil Sekolah</a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="swiper-pagination"></div>
    </div>

    <!-- Kartu ringkas yang menumpuk di batas bawah hero -->
    <div class="wrap relative z-10 -mt-14">
      <div class="grid gap-px overflow-hidden rounded-2xl bg-slate-200 shadow-xl sm:grid-cols-3">
        <div class="bg-white px-6 py-6 text-center">
          <p class="font-display text-3xl font-extrabold text-navy-900">{statistik.guru}</p>
          <p class="mt-1 text-[13px] text-slate-600">Guru &amp; Tenaga Pendidik</p>
        </div>
        <div class="bg-white px-6 py-6 text-center">
          <p class="font-display text-3xl font-extrabold text-navy-900">{totalSiswa}</p>
          <p class="mt-1 text-[13px] text-slate-600">Peserta Didik Aktif</p>
        </div>
        <div class="bg-white px-6 py-6 text-center">
          <p class="font-display text-3xl font-extrabold text-navy-900">{programKeahlian.length}</p>
          <p class="mt-1 text-[13px] text-slate-600">Program Keahlian</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SAMBUTAN KEPALA SEKOLAH ================= -->
  <section class="py-16 sm:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div data-aos="fade-right">
        <div class="relative mx-auto max-w-82.5">
          <div class="absolute -bottom-4 -right-4 h-full w-full rounded-2xl bg-amber-brand/20"></div>
          <img
            src={sambutan.foto}
            alt={`Foto ${sambutan.nama}`}
            width="400"
            height="480"
            loading="lazy"
            decoding="async"
            class="relative rounded-2xl shadow-lg"
          />
        </div>
      </div>

      <div data-aos="fade-left">
        <Judul label="Sambutan" judul="Kepala Sekolah" />
        <blockquote class="mt-6 border-l-4 border-amber-brand pl-5 text-[15.5px] leading-relaxed text-slate-700">
          {sambutan.pesan}
        </blockquote>
        <div class="mt-6">
          <p class="font-display text-lg font-bold text-navy-900">{sambutan.nama}</p>
          <p class="text-sm text-slate-500">{sambutan.jabatan}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PROGRAM KEAHLIAN ================= -->
  <section class="bg-navy-50 py-16 sm:py-24">
    <div class="wrap">
      <Judul
        tengah
        label="Kompetensi Keahlian"
        judul="Program Keahlian Kami"
        keterangan="Tiga program keahlian yang dirancang mengikuti kebutuhan dunia usaha dan dunia industri."
      />

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          programKeahlian.map((p, i) => (
            <article class="card card-hover p-7" data-aos="fade-up" data-aos-delay={i * 100}>
              <div class={`inline-flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br ${warnaProgram[p.warna]} text-white`}>
                <svg width="27" height="27" viewBox="0 0 24 24" fill="currentColor">
                  <path d={ikonProgram[p.ikon]} />
                </svg>
              </div>

              <h3 class="mt-5 font-display text-lg font-bold text-navy-900">{p.nama}</h3>
              <p class="mt-1 text-xs font-bold uppercase tracking-wider text-amber-deep">
                {p.singkatan} &middot; {p.rombel} rombongan belajar
              </p>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{p.deskripsi}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <a href="/program-keahlian" class="btn bg-navy-800 text-white hover:bg-navy-600">
          Pelajari Selengkapnya
        </a>
      </div>
    </div>
  </section>

  <!-- ================= JUMLAH GURU DAN SISWA ================= -->
  <Statistik />

  <!-- ================= VIDEO PROFIL (MULTIMEDIA) ================= -->
  <VideoProfil />

  <!-- ================= BERITA KEGIATAN ================= -->
  <section class="py-16 sm:py-24">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <Judul
          label="Kabar Sekolah"
          judul="Berita Kegiatan Terbaru"
          keterangan="Catatan kegiatan akademik, prestasi, dan pengabdian masyarakat yang berlangsung di sekolah."
        />
        <a href="/berita" class="btn bg-navy-800 text-white hover:bg-navy-600">Semua Berita</a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {beritaTerbaru.map((b, i) => <KartuBerita berita={b} urutan={i} />)}
      </div>
    </div>
  </section>

  <!-- ================= GALERI ================= -->
  <section class="bg-navy-50 py-16 sm:py-24">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <Judul label="Dokumentasi" judul="Galeri Kegiatan" />
        <a href="/galeri" class="btn bg-navy-800 text-white hover:bg-navy-600">Galeri Lengkap</a>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3">
        {
          cuplikanGaleri.map((g, i) => (
            <a
              href={g.berkas}
              class="glightbox group relative block aspect-4/3 overflow-hidden rounded-xl bg-navy-100"
              data-gallery="beranda"
              data-title={g.judul}
              data-aos="zoom-in"
              data-aos-delay={i * 60}
            >
              {/*
                `h-full!` sengaja dipaksa. Berkas gaya GLightbox memuat
                `img { height: auto }` TANPA @layer, dan aturan tanpa layer
                selalu menang atas seluruh utility Tailwind yang berlapis —
                berapa pun kekhususannya. Tanpa tanda seru, gambar memakai
                tinggi alaminya dan menyisakan celah di bawah kartu.
              */}
              <img
                src={g.berkas}
                alt={g.judul}
                width="1200"
                height="800"
                loading="lazy"
                class="absolute inset-0 h-full! w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />

              {/* Judul selalu terlihat — kalau hanya muncul saat hover, layar sentuh tidak pernah menampilkannya. */}
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-900/90 via-navy-900/45 to-transparent p-4 pt-10">
                <span class="text-sm font-semibold text-white drop-shadow">{g.judul}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= AJAKAN ================= -->
  <section class="relative overflow-hidden bg-navy-800 py-16">
    <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-amber-brand/12"></div>
    <div class="wrap relative flex flex-col items-center gap-6 text-center">
      <h2 class="max-w-2xl font-display text-3xl font-extrabold text-white sm:text-4xl">
        Bergabunglah bersama {identitas.namaSingkat}
      </h2>
      <p class="max-w-xl text-[15px] leading-relaxed text-navy-200">
        Penerimaan peserta didik baru tahun ajaran berikutnya telah dibuka.
        Hubungi kami untuk informasi jadwal dan persyaratan pendaftaran.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/kontak" class="btn btn-primary">Hubungi Sekolah</a>
        <a href="/profil" class="btn btn-outline">Tentang Kami</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination, EffectFade } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/effect-fade';

  import GLightbox from 'glightbox';
  import 'glightbox/dist/css/glightbox.min.css';

  /**
   * Menyiapkan dua library pre-existing pada halaman beranda:
   *  - Swiper untuk pergantian gambar sampul secara otomatis.
   *  - GLightbox agar foto galeri dapat dibuka besar tanpa pindah halaman.
   */
  function siapkanBeranda(): void {
    const hero = document.querySelector('.hero-swiper');
    if (hero) {
      new Swiper('.hero-swiper', {
        modules: [Autoplay, Pagination, EffectFade],
        loop: true,
        effect: 'fade',
        fadeEffect: { crossFade: true },
        speed: 900,
        autoplay: { delay: 6000, disableOnInteraction: false },
        pagination: { el: '.swiper-pagination', clickable: true },
      });
    }

    if (document.querySelector('.glightbox')) {
      GLightbox({ selector: '.glightbox', touchNavigation: true, loop: true });
    }
  }

  siapkanBeranda();
  document.addEventListener('astro:page-load', siapkanBeranda);
</script>

<style is:global>
  /* Titik navigasi Swiper disesuaikan dengan warna sekolah. */
  .hero-swiper .swiper-pagination-bullet {
    width: 26px;
    height: 4px;
    border-radius: 999px;
    background: #ffffff;
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .hero-swiper .swiper-pagination-bullet-active {
    background: var(--color-amber-brand);
    opacity: 1;
  }

  .hero-swiper .swiper-pagination {
    bottom: 84px !important;
  }
</style>
