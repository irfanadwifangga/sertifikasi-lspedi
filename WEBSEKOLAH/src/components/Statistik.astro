---
/**
 * Statistik — bagian "informasi jumlah guru dan siswa" pada halaman utama.
 *
 * Bagian ini memenuhi dua unit sekaligus:
 *  - Angka yang menghitung naik saat masuk layar (user interface interaktif).
 *  - Grafik lingkaran memakai library Chart.js yang digambar pada elemen
 *    <canvas> (perintah eksekusi berbasis GRAFIK).
 */
import sekolah from '../data/sekolah.json';
import { formatNumber } from '../utils/format';

const { statistik, mutu } = sekolah;
const totalSiswa = statistik.siswaLakiLaki + statistik.siswaPerempuan;

/** Kartu angka utama. Ditulis sebagai array agar mudah ditambah. */
const kartu = [
  { label: 'Guru & Tenaga Pendidik', nilai: statistik.guru, ikon: 'guru', warna: 'text-sky-300' },
  { label: 'Peserta Didik', nilai: totalSiswa, ikon: 'siswa', warna: 'text-amber-brand' },
  { label: 'Rombongan Belajar', nilai: statistik.rombonganBelajar, ikon: 'kelas', warna: 'text-emerald-300' },
  { label: 'Mitra Industri', nilai: mutu.mitraIndustri, ikon: 'mitra', warna: 'text-violet-300' },
];

const ikon: Record<string, string> = {
  guru: 'M12 3 2 8l10 5 10-5zM4 12v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5l-8 4z',
  siswa: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 21a7 7 0 0 1 14 0zm14.5 0a8.5 8.5 0 0 0-1.7-5A5 5 0 0 1 22 21z',
  kelas: 'M3 5h18v11H3zm2 13h14v2H5zM7 8h10v2H7zm0 3h6v2H7z',
  mitra: 'M7 11V6a1.5 1.5 0 0 1 3 0v4h1V4.5a1.5 1.5 0 0 1 3 0V10h1V6a1.5 1.5 0 0 1 3 0v8a6 6 0 0 1-6 6h-2a5 5 0 0 1-5-5v-4a1.5 1.5 0 0 1 3 0z',
};
---

<section class="relative overflow-hidden bg-navy-900 py-16 sm:py-20">
  <!-- Hiasan latar -->
  <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-amber-brand/10"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-white/5"></div>

  <div class="wrap relative">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <!-- Kolom kiri: kartu angka -->
      <div>
        <span class="eyebrow text-amber-brand">Sekolah dalam Angka</span>
        <h2 class="rule mt-2 font-display text-3xl font-extrabold text-white sm:text-4xl">
          Data Guru dan Peserta Didik
        </h2>
        <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-navy-200">
          Ringkasan kondisi sekolah pada semester {sekolah.identitas.semesterData}.
          Angka berikut menjadi dasar perencanaan kegiatan belajar dan
          penempatan praktik kerja lapangan.
        </p>

        <div class="mt-9 grid grid-cols-2 gap-4 sm:gap-5">
          {
            kartu.map((k, i) => (
              <div
                class="rounded-2xl border border-white/12 bg-white/6 p-5 backdrop-blur-sm"
                data-aos="fade-up"
                data-aos-delay={i * 90}
              >
                <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class={k.warna}>
                  <path d={ikon[k.ikon]} />
                </svg>
                <p
                  class="angka mt-3 font-display text-3xl font-extrabold text-white sm:text-4xl"
                  data-nilai={k.nilai}
                >
                  0
                </p>
                <p class="mt-1 text-[13px] leading-snug text-navy-200">{k.label}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Kolom kanan: grafik Chart.js -->
      <div
        class="rounded-2xl border border-white/12 bg-white/6 p-6 backdrop-blur-sm sm:p-8"
        data-aos="fade-left"
      >
        <h3 class="font-display text-lg font-bold text-white">Komposisi Peserta Didik</h3>
        <p class="mt-1 text-[13px] text-navy-200">
          Total {formatNumber(totalSiswa)} peserta didik pada {statistik.rombonganBelajar} rombongan belajar.
        </p>

        <div class="relative mx-auto mt-6 h-[260px]">
          <canvas
            id="grafik-siswa"
            data-laki={statistik.siswaLakiLaki}
            data-perempuan={statistik.siswaPerempuan}></canvas>
        </div>

        <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-white/12 pt-5 text-center">
          <div>
            <dt class="text-[12px] text-navy-200">Rasio Siswa : Guru</dt>
            <dd class="font-display text-xl font-bold text-white">1 : {mutu.rasioSiswaGuru}</dd>
          </div>
          <div>
            <dt class="text-[12px] text-navy-200">Guru Bersertifikasi</dt>
            <dd class="font-display text-xl font-bold text-white">{mutu.persentaseGuruSertifikasi}%</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  /**
   * Menyiapkan animasi angka dan grafik lingkaran.
   *
   * Keduanya baru dijalankan ketika elemennya benar-benar masuk ke layar,
   * memakai IntersectionObserver. Cara ini menghemat pekerjaan peramban
   * sekaligus membuat animasinya terlihat oleh pengguna.
   */
  function siapkanStatistik(): void {
    // ---------- Angka yang menghitung naik ----------
    const angkaSemua = document.querySelectorAll<HTMLElement>('.angka');

    /**
     * Menghitung angka dari nol sampai nilai tujuan.
     *
     * @param elemen Elemen tempat angka ditampilkan.
     */
    function hitungNaik(elemen: HTMLElement): void {
      const tujuan = Number(elemen.dataset.nilai ?? 0);
      const durasi = 1400;
      const mulai = performance.now();

      function langkah(waktu: number): void {
        const maju = Math.min((waktu - mulai) / durasi, 1);
        // Perlambatan di akhir agar terasa halus.
        const mulus = 1 - Math.pow(1 - maju, 3);
        elemen.textContent = Math.round(tujuan * mulus).toLocaleString('id-ID');

        if (maju < 1) requestAnimationFrame(langkah);
      }

      requestAnimationFrame(langkah);
    }

    if (angkaSemua.length > 0) {
      const pengamat = new IntersectionObserver(
        (entri) => {
          for (const e of entri) {
            if (!e.isIntersecting) continue;
            hitungNaik(e.target as HTMLElement);
            pengamat.unobserve(e.target);
          }
        },
        { threshold: 0.4 },
      );

      angkaSemua.forEach((el) => pengamat.observe(el));
    }

    // ---------- Grafik lingkaran ----------
    const kanvas = document.getElementById('grafik-siswa') as HTMLCanvasElement | null;
    if (!kanvas) return;

    const laki = Number(kanvas.dataset.laki ?? 0);
    const perempuan = Number(kanvas.dataset.perempuan ?? 0);

    const pengamatGrafik = new IntersectionObserver(
      (entri) => {
        for (const e of entri) {
          if (!e.isIntersecting) continue;

          new Chart(kanvas, {
            type: 'doughnut',
            data: {
              labels: ['Laki-laki', 'Perempuan'],
              datasets: [
                {
                  data: [laki, perempuan],
                  backgroundColor: ['#38bdf8', '#f5a524'],
                  borderWidth: 0,
                  hoverOffset: 10,
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '62%',
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    color: '#c6d8ef',
                    boxWidth: 12,
                    padding: 16,
                    font: { size: 12 },
                  },
                },
                tooltip: {
                  callbacks: {
                    label: (konteks) => {
                      const nilai = konteks.parsed as number;
                      const total = laki + perempuan;
                      const persen = ((nilai / total) * 100).toFixed(1);
                      return ` ${konteks.label}: ${nilai} siswa (${persen}%)`;
                    },
                  },
                },
              },
            },
          });

          pengamatGrafik.unobserve(e.target);
        }
      },
      { threshold: 0.3 },
    );

    pengamatGrafik.observe(kanvas);
  }

  siapkanStatistik();
  document.addEventListener('astro:page-load', siapkanStatistik);
</script>
