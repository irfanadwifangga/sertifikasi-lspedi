---
/**
 * Footer — kaki halaman yang tampil di seluruh halaman situs.
 *
 * Isinya diambil langsung dari berkas data sekolah, sehingga perubahan alamat
 * atau nomor telepon cukup dilakukan sekali di `src/data/sekolah.json`.
 */
import sekolah from '../data/sekolah.json';

const { identitas, kontak, statistik } = sekolah;

const quickLinks = [
  { label: 'Profil Sekolah', href: '/profil' },
  { label: 'Program Keahlian', href: '/program-keahlian' },
  { label: 'Ekstrakurikuler', href: '/ekstrakurikuler' },
  { label: 'Galeri', href: '/galeri' },
  { label: 'Berita', href: '/berita' },
  { label: 'Kontak', href: '/kontak' },
];

const totalStudents = statistik.siswaLakiLaki + statistik.siswaPerempuan;
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-900 text-navy-100">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <!-- Identitas -->
    <div class="lg:col-span-1">
      <div class="flex items-center gap-3">
        <img
          src="/img/logo.svg"
          alt=""
          width="44"
          height="44"
          loading="lazy"
          decoding="async"
          class="h-11 w-11"
        />
        <div class="leading-tight">
          <p class="font-display text-[15px] font-extrabold text-white">{identitas.namaSingkat}</p>
          <p class="text-[11px] text-navy-200">{identitas.tagline}</p>
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-navy-200">
        Sekolah menengah kejuruan bidang teknologi yang berdiri sejak {identitas.tahunBerdiri},
        dengan {statistik.guru} guru dan {totalStudents} peserta didik.
      </p>
    </div>

    <!-- Tautan cepat -->
    <div>
      <h3 class="mb-4 font-display text-sm font-bold uppercase tracking-wider text-white">Tautan Cepat</h3>
      <ul class="space-y-2.5 text-sm">
        {
          quickLinks.map((t) => (
            <li>
              <a href={t.href} class="text-navy-200 transition-colors hover:text-amber-brand">
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Kontak -->
    <div>
      <h3 class="mb-4 font-display text-sm font-bold uppercase tracking-wider text-white">Hubungi Kami</h3>
      <ul class="space-y-3 text-sm text-navy-200">
        <li class="flex gap-2.5">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-amber-brand">
            <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z" /><circle cx="12" cy="10" r="2.6" />
          </svg>
          <span>{kontak.alamat}, {kontak.kelurahan}, Kec. {kontak.kecamatan}, {kontak.kabupaten}, {kontak.provinsi} {kontak.kodePos}</span>
        </li>
        <li class="flex gap-2.5">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-amber-brand">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z" />
          </svg>
          <span>{kontak.telepon}</span>
        </li>
        <li class="flex gap-2.5">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-amber-brand">
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
          </svg>
          <span>{kontak.email}</span>
        </li>
      </ul>
    </div>

    <!-- Jam layanan -->
    <div>
      <h3 class="mb-4 font-display text-sm font-bold uppercase tracking-wider text-white">Jam Layanan</h3>
      <p class="text-sm text-navy-200">{kontak.jamOperasional}</p>
      <div class="mt-5 rounded-xl border border-white/12 bg-white/6 p-4">
        <p class="text-[11px] uppercase tracking-wider text-navy-200">Akreditasi</p>
        <p class="font-display text-3xl font-extrabold text-amber-brand">{identitas.akreditasi}</p>
        <p class="text-[11px] text-navy-200">NPSN {identitas.npsn}</p>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col items-center justify-between gap-2 py-5 text-center text-xs text-navy-200 sm:flex-row sm:text-left">
      <p>&copy; {currentYear} {identitas.nama}. Seluruh hak cipta dilindungi.</p>
      <p>Data pada situs ini bersifat fiktif, dibuat untuk keperluan Tugas Praktik Demonstrasi.</p>
    </div>
  </div>
</footer>
