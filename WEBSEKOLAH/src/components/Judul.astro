---
/**
 * Judul — kepala setiap bagian halaman.
 *
 * Dibuat sebagai komponen tersendiri agar seluruh bagian di situs memakai
 * susunan dan jarak yang sama. Bila kelak gayanya diubah, cukup berkas ini
 * yang disunting.
 */
interface Props {
  /** Label kecil di atas judul, misalnya "Profil Sekolah". */
  label?: string;
  /** Judul utama bagian. */
  judul: string;
  /** Kalimat penjelas di bawah judul. */
  keterangan?: string;
  /** Rata tengah, dipakai pada bagian yang berdiri sendiri. */
  tengah?: boolean;
  /** Warna terang untuk dipakai di atas latar gelap. */
  terang?: boolean;
}

const { label, judul, keterangan, tengah = false, terang = false } = Astro.props;
---

<div class={`${tengah ? 'text-center' : ''} ${tengah ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}>
  {label && <span class={`eyebrow ${terang ? 'text-amber-brand' : ''}`}>{label}</span>}

  <h2
    class={`rule ${tengah ? 'rule-center' : ''} mt-2 font-display text-3xl font-extrabold sm:text-4xl ${
      terang ? 'text-white' : 'text-navy-900'
    }`}
  >
    {judul}
  </h2>

  {
    keterangan && (
      <p class={`mt-5 text-[15px] leading-relaxed ${terang ? 'text-navy-200' : 'text-slate-600'}`}>
        {keterangan}
      </p>
    )
  }
</div>
