---
/**
 * NewsCard — satu kartu berita kegiatan sekolah.
 *
 * Dipakai berulang di halaman Beranda maupun halaman Berita. Karena bentuknya
 * komponen, penambahan berita cukup dilakukan di `src/data/berita.json`
 * tanpa menyentuh kode tampilan sama sekali.
 */
import { formatDate, truncateText } from '../utils/format';

interface Props {
  /** Satu entri dari berita.json. Nama bidangnya mengikuti berkas data. */
  news: {
    slug: string;
    judul: string;
    tanggal: string;
    kategori: string;
    ringkasan: string;
    gambar: string;
    penulis: string;
  };
  /** Nomor urut, dipakai untuk menunda animasi agar kartu muncul berurutan. */
  index?: number;
}

const { news, index = 0 } = Astro.props;

/** Warna lencana disesuaikan dengan kategori beritanya. */
const categoryBadge: Record<string, string> = {
  Prestasi: 'bg-amber-100 text-amber-800',
  Akademik: 'bg-violet-100 text-violet-800',
  Kesiswaan: 'bg-sky-100 text-sky-800',
  Pengabdian: 'bg-rose-100 text-rose-800',
  Pengumuman: 'bg-emerald-100 text-emerald-800',
};

const badgeClass = categoryBadge[news.kategori] ?? 'bg-slate-100 text-slate-700';

/** Ringkasan dipangkas agar tinggi seluruh kartu dalam satu baris tetap sama. */
const summary = truncateText(news.ringkasan, 118);
---

<article
  class="card card-hover flex flex-col"
  data-aos="fade-up"
  data-aos-delay={index * 80}
>
  <div class="relative aspect-[3/2] overflow-hidden bg-navy-100">
    <img
      src={news.gambar}
      alt={news.judul}
      width="1200"
      height="800"
      loading="lazy"
      class="h-full! w-full object-cover transition-transform duration-500 hover:scale-105"
    />
    <span class={`absolute left-3 top-3 rounded-full px-2.5 py-1 text-[11px] font-bold ${badgeClass}`}>
      {news.kategori}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <time datetime={news.tanggal} class="text-xs font-semibold text-slate-500">
      {formatDate(news.tanggal)}
    </time>

    <h3 class="mt-2 font-display text-[17px] font-bold leading-snug text-navy-900">
      {news.judul}
    </h3>

    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-slate-600">
      {summary}
    </p>

    <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3.5">
      <span class="text-xs text-slate-500">{news.penulis}</span>
      <a
        href={`/berita/${news.slug}`}
        class="inline-flex items-center gap-1 text-sm font-semibold text-navy-600 transition-colors hover:text-amber-deep"
      >
        Baca selengkapnya
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</article>
